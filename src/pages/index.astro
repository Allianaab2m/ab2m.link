---
import { getEntry, render } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Footer from '@components/Footer.astro'
import Navbar from '@components/Navbar.astro'
import BackToTop from '@components/control/BackToTop.astro'
import ImageWrapper from '@components/misc/ImageWrapper.astro'
import Markdown from '@components/misc/Markdown.astro'
import Timeline from '@components/Timeline.astro'
import Layout from '../layouts/Layout.astro'
import { profileConfig, siteConfig } from '../config'
import { timeline } from '../data/timeline'
import I18nKey from '../i18n/i18nKey'
import { i18n } from '../i18n/translation'
import { url } from '../utils/url-utils'

const aboutPost = await getEntry('spec', 'about')
if (!aboutPost) throw new Error('src/content/spec/about.md is missing')
const { Content } = await render(aboutPost)
---

<Layout title={siteConfig.title} description={profileConfig.bio}>
    <div class="max-w-[var(--page-width)] min-h-screen mx-auto px-0 md:px-4 flex flex-col gap-4">
        <Navbar></Navbar>

        <main id="swup-container" class="transition-swup-fade flex flex-col gap-4 flex-1">
            <!-- Hero -->
            <section class="card-base relative overflow-hidden onload-animation">
                <div class="absolute inset-0 pointer-events-none opacity-60
                            bg-gradient-to-br from-[oklch(0.95_0.05_var(--hue))] via-transparent to-[oklch(0.92_0.08_var(--hue))]
                            dark:from-[oklch(0.25_0.05_var(--hue))] dark:via-transparent dark:to-[oklch(0.22_0.08_var(--hue))]"></div>
                <div class="relative flex flex-col items-center text-center px-6 py-12 md:py-20">
                    <div class="relative mb-6">
                        <div class="absolute -inset-2 rounded-full bg-[var(--primary)]/20 blur-xl"></div>
                        <div class="relative w-36 h-36 md:w-48 md:h-48 rounded-full overflow-hidden ring-4 ring-[var(--card-bg)] shadow-xl">
                            <ImageWrapper src={profileConfig.avatar || ''} alt={`Profile Image of ${profileConfig.name}`} class="w-full h-full" />
                        </div>
                    </div>
                    <h1 class="text-3xl md:text-5xl font-bold text-90 mb-3 transition tracking-tight">
                        {profileConfig.name}
                    </h1>
                    <div class="h-1 w-12 bg-[var(--primary)] rounded-full mb-5 transition"></div>
                    <p class="text-75 text-base md:text-lg max-w-xl mb-7 transition leading-relaxed">
                        {profileConfig.bio}
                    </p>
                    <div class="flex flex-wrap gap-2 justify-center mb-7">
                        {profileConfig.links.map(item => (
                            <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                               class="btn-regular rounded-lg h-11 w-11 active:scale-90 transition">
                                <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            </a>
                        ))}
                    </div>
                    <div class="flex flex-wrap gap-3 justify-center">
                        <a href={url('/blog/')}
                           class="btn-regular rounded-lg h-11 px-5 font-bold active:scale-95 inline-flex items-center gap-2">
                            <Icon name="material-symbols:article-outline-rounded" class="text-[1.25rem]"></Icon>
                            {i18n(I18nKey.blog)}
                        </a>
                        <a href={url('/archive/')}
                           class="btn-plain rounded-lg h-11 px-5 font-bold active:scale-95 inline-flex items-center gap-2">
                            <Icon name="material-symbols:inventory-2-outline-rounded" class="text-[1.25rem]"></Icon>
                            {i18n(I18nKey.archive)}
                        </a>
                    </div>
                </div>
            </section>

            <!-- About body -->
            <section class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative onload-animation"
                     style="animation-delay: 100ms">
                <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
                    <div class="flex items-center gap-2 mb-4">
                        <Icon name="fa6-regular:address-card" class="text-[1.5rem] text-[var(--primary)]"></Icon>
                        <h2 class="text-2xl font-bold text-90 transition">{i18n(I18nKey.about)}</h2>
                    </div>
                    <Markdown class="">
                        <Content />
                    </Markdown>
                </div>
            </section>

            <!-- Timeline -->
            <section class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative onload-animation"
                     style="animation-delay: 200ms">
                <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
                    <div class="flex items-center gap-2 mb-6">
                        <Icon name="material-symbols:history-rounded" class="text-[1.5rem] text-[var(--primary)]"></Icon>
                        <h2 class="text-2xl font-bold text-90 transition">Timeline</h2>
                    </div>
                    <Timeline entries={timeline} />
                </div>
            </section>
        </main>

        <div id="footer" class="mt-4 onload-animation">
            <Footer></Footer>
        </div>
        <BackToTop></BackToTop>
    </div>
</Layout>
