---
import { Icon } from 'astro-icon/components'
import type { TimelineEntry } from '../data/timeline'

interface Props {
  entries: TimelineEntry[]
  class?: string
}

const { entries } = Astro.props
const className = Astro.props.class
---

<div class:list={['relative', className]}>
    <div class="absolute top-1 bottom-1 left-2 border-l-2 border-dashed border-[var(--line-divider)]"></div>
    <ol class="relative space-y-7">
        {entries.map((entry) => (
            <li class="relative pl-8">
                <span class="absolute left-2 top-1.5 -translate-x-1/2 w-3 h-3 rounded-full bg-[var(--primary)] ring-4 ring-[var(--card-bg)]"></span>
                <div class="flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400 mb-1 transition">
                    {entry.icon && <Icon name={entry.icon} class="text-base" />}
                    <time>{entry.date}</time>
                </div>
                <h3 class="text-lg font-bold text-90 mb-1 leading-snug transition">{entry.title}</h3>
                {entry.description && (
                    <p class="text-75 text-sm leading-relaxed transition">{entry.description}</p>
                )}
                {entry.link && (
                    <a
                        href={entry.link.url}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-0.5 mt-1 text-sm text-[var(--primary)] hover:underline"
                    >
                        {entry.link.label ?? entry.link.url}
                        <Icon name="material-symbols:chevron-right-rounded" class="text-base" />
                    </a>
                )}
            </li>
        ))}
    </ol>
</div>
